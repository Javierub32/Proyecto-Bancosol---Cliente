@import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;700&display=swap');


/* ============================
   Layout general campañas
   ============================ */

.main-page {
    padding: 25px;
    box-sizing: border-box;
    min-height: calc(100vh - 80px);
}

.campanya-form-wrapper {
    max-width: 900px;
    margin: 0 auto;
}

.campanya-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.campanya-header h1 {
    font-size: 1.4rem;
    margin: 0;
    color: var(--text-dark);
}

.campanya-header p {
    margin: 6px 0 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* ============================
   Tarjeta del formulario
   ============================ */

.campanya-form-card {
    padding: 25px;
}

.campanya-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.form-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.form-section-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--primary-blue);
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
}

.form-row {
    display: flex;
    gap: 18px;
}

.form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dark);
}

.form-group input[type="text"],
.form-group input[type="date"],
.form-group select {
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.95rem;
    background-color: white;
    color: var(--text-dark);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.form-group input[type="text"]:focus,
.form-group input[type="date"]:focus,
.form-group select:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(68, 114, 196, 0.12);
}

/* ============================
   Radios tipo campaña
   ============================ */

.radio-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.option-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background-color: #f8fafc;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s, transform 0.1s;
}

.option-card:hover {
    border-color: var(--accent-blue);
    background-color: #f0f7ff;
}

.option-card input {
    accent-color: var(--primary-blue);
    cursor: pointer;
}

.option-card span {
    font-size: 0.9rem;
    color: var(--text-dark);
}

/* ============================
   Checkboxes cadenas
   ============================ */

.checkbox-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.checkbox-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 14px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background-color: white;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
}

.checkbox-card:hover {
    border-color: var(--accent-blue);
    background-color: #f8fafc;
}

.checkbox-card input {
    accent-color: var(--primary-blue);
    cursor: pointer;
    transform: scale(1.1);
}

.checkbox-card span {
    font-size: 0.9rem;
    color: var(--text-dark);
}

/* ============================
   Nota informativa
   ============================ */

.info-box {
    padding: 12px 14px;
    background-color: #f8fafc;
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent-blue);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* ============================
   Botones
   ============================ */

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--border-color);
}

.form-actions a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-danger-outline {
    background-color: white;
    color: var(--status-red);
    border: 1px solid var(--status-red);
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
}

.btn-danger-outline:hover {
    background-color: #fef2f2;
}

/* ============================
   Responsive básico
   ============================ */

@media (max-width: 800px) {
    .form-row {
        flex-direction: column;
    }

    .radio-grid,
    .checkbox-grid {
        grid-template-columns: 1fr;
    }

    .campanya-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
    }

    .form-actions {
        flex-direction: column;
    }

    .form-actions button,
    .form-actions a {
        width: 100%;
    }
}

/* ============================
   Listado de campañas
   ============================ */

.campanya-list-wrapper {
    max-width: 1100px;
    margin: 0 auto;
}

.campanya-table-card {
    padding: 0;
    overflow: hidden;
}
/* ============================ */

/*Retoques de la tabla para campañas*/

.modernTable {
    table-layout: fixed;

}

