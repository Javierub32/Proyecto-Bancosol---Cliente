                <div class="form-group-row">
                    <div class="form-group">
                        <label for="input_hora_inicio">Hora Inicio:</label>
                        <input id="input_hora_inicio" type="time" name="horaInicio">
                    </div>
                    <div class="form-group">
                        <label for="input_hora_fin">Hora Fin:</label>
