}

.left-column { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.right-column {
    width: 0; opacity: 0; overflow: hidden; display: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.right-column.open {
    width: 400px; margin-left: 25px; opacity: 1; display: flex; flex-direction: column;
}

.table-container { overflow-y: auto; background-color: var(--bg-white); border-radius: 8px; border: 1px solid var(--border-color); }
.modernTable { width: 100%; border-collapse: collapse; text-align: left; }
.modernTable thead { background-color: var(--primary-blue); color: white; position: sticky; top: 0; z-index: 10; }
.modernTable th, .modernTable td { padding: 14px 15px; border-bottom: 1px solid var(--border-color); }
.modernTable tbody tr { transition: background 0.2s; cursor: pointer; }
.modernTable tbody tr:hover { background-color: var(--bg-main); }
.modernTable tbody tr.selected { background-color: #f0f7ff; border-left: 4px solid var(--primary-blue); }
.font-medium { font-weight: 500; }
.text-blue { color: var(--accent-blue); }

.side-panel-unified { height: fit-content; display: flex; flex-direction: column; }
