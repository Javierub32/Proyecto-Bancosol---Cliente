    color: var(--primary-blue);
    border: 1px solid var(--primary-blue);
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-outline:hover {
    background-color: var(--bg-main);
}

.text-mutex {
