/* Layout Principal (Animado) */
.page-wrapper {
	display: flex;
	/* Quitamos el gap de aquí para que no deje un espacio vacío cuando el panel esté oculto */
	padding: 25px;
	height: calc(100vh - 80px);
	box-sizing: border-box;
}

.left-column {
	flex: 1; /* Ocupará todo el espacio disponible automáticamente */
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.right-column {
	width: 0;
	opacity: 0;
	overflow: hidden;
	/* Esta es la magia: una transición de 0.3 segundos muy fluida */
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Esta clase se la pondremos con JavaScript cuando queramos abrirlo */
.right-column.open {
	width: 400px;
	margin-left: 25px; /* Separación con la tabla */
	opacity: 1;
}

/* Encabezado sobre la tabla */
.header-actions {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 20px;
}

.header-actions h1 {
	font-size: 1.4rem;
	margin: 0;
	color: var(--text-dark);
}

/* ============================
   ESTILOS DE LA TABLA
   ============================ */
.table-container {
	overflow-y: auto; /* Scroll interno para la tabla */
	padding: 0; /* Sin padding para que la cabecera llegue al borde */
}

table {
	width: 100%;
	border-collapse: collapse;
	text-align: left;
}

thead {
	background-color: var(--primary-blue);
	color: white;
	position: sticky;
	top: 0;
	z-index: 10;
}

th, td {
	padding: 14px 15px;
	border-bottom: 1px solid var(--border-color);
}

th {
	font-weight: 500;
	font-size: 0.85rem;
}

tbody tr {
	transition: background 0.2s;
	cursor: pointer;
	background-color: var(--bg-white);
}

tbody tr:hover {
	background-color: var(--bg-main);
}

/* Estilo para la fila seleccionada */
tbody tr.selected {
	background-color: #f0f7ff;
