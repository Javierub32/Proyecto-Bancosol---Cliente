@import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap');

:root {
    /* Paleta de colores basada en tu diseño */
    --primary-blue: #003366; /* Azul oscuro para cabeceras de tabla y botones */
    --accent-blue: #4472c4;  /* Azul secundario */
    --bg-main: #f4f7fb;      /* Color de fondo de la web */
    --bg-white: #ffffff;     /* Fondo de las tarjetas */

    --text-dark: #1e293b;
    --text-muted: #64748b;
    --border-color: #e2e8f0;

    /* Colores de estado */
    --status-green: #10b981;
    --status-red: #ef4444;
    --status-yellow: #f59e0b;
}

body {
    font-family: 'Public Sans', sans-serif;
    margin: 0;
    padding: 0;
    background-color: var(--bg-main);
    color: var(--text-dark);
}

