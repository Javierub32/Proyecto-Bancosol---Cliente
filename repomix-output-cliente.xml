<file path="css/asignacion_turno.css">
/* Layout Principal (Animado) */
.page-wrapper {
	display: flex;
	/* Quitamos el gap de aquí para que no deje un espacio vacío cuando el panel esté oculto */
	padding: 25px;
	height: calc(100vh - 80px);
	box-sizing: border-box;
}

.left-column {
	flex: 1; /* Ocupará todo el espacio disponible automáticamente */
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.right-column {
	width: 0;
	opacity: 0;
	overflow: hidden;
	/* Esta es la magia: una transición de 0.3 segundos muy fluida */
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Esta clase se la pondremos con JavaScript cuando queramos abrirlo */
.right-column.open {
	width: 400px;
	margin-left: 25px; /* Separación con la tabla */
	opacity: 1;
}

/* Encabezado sobre la tabla */
.header-actions {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 20px;
}

.header-actions h1 {
	font-size: 1.4rem;
	margin: 0;
	color: var(--text-dark);
}

/* ============================
   ESTILOS DE LA TABLA
   ============================ */
.table-container {
	overflow-y: auto; /* Scroll interno para la tabla */
	padding: 0; /* Sin padding para que la cabecera llegue al borde */
}

table {
	width: 100%;
	border-collapse: collapse;
	text-align: left;
}

thead {
	background-color: var(--primary-blue);
	color: white;
	position: sticky;
	top: 0;
	z-index: 10;
}

th, td {
	padding: 14px 15px;
	border-bottom: 1px solid var(--border-color);
}

th {
	font-weight: 500;
	font-size: 0.85rem;
}

tbody tr {
	transition: background 0.2s;
	cursor: pointer;
	background-color: var(--bg-white);
}

tbody tr:hover {
	background-color: var(--bg-main);
}

/* Estilo para la fila seleccionada */
tbody tr.selected {
	background-color: #f0f7ff;
	border-left: 4px solid var(--primary-blue);
}

.font-medium {
	font-weight: 500;
}

.text-blue {
	color: var(--accent-blue);
}

.small-td {
	font-size: 0.8rem;
	color: var(--text-muted);
}

.side-panel {
	width: 400px; /* Ancho fijo para que su contenido interno no se aplaste durante la animación */
	height: 100%;
	overflow-y: auto;
	padding: 25px;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
}

#volunteer-container {
	display: flex;
	flex-direction: column;
	gap: 20px;
}

/* Título de la tienda en el panel derecho */
#lbl-tienda {
	font-size: 1.3rem;
	font-weight: 600;
	color: var(--primary-blue);
	margin: 0 0 5px 0;
}

#lbl-domicilio {
	font-size: 0.9rem;
	color: var(--text-muted);
	margin: 0;
}

/* Selector de horarios (Radio buttons) */
#volunteer-schedule, #volunteer-lineal {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10px;
	background-color: var(--bg-main);
	padding: 15px;
	border-radius: 8px;
	border: 1px solid var(--border-color);
}

#volunteer-schedule label, #volunteer-lineal label {
	font-size: 0.85rem;
	display: flex;
	align-items: center;
	gap: 8px;
	cursor: pointer;
}

/* Info del capitán y horas */
#volunteer-info {
	border: 1px solid var(--border-color);
	border-radius: 8px;
	overflow: hidden;
}

#volunteer-name {
	display: flex;
	background-color: #f8fafc;
	border-bottom: 1px solid var(--border-color);
}

#volunteer-name > div:first-child {
	flex: 1;
	padding: 15px;
}

.volunteer-date {
	flex: 1;
	padding: 15px;
	text-align: center;
	align-self: center;
	border-left: 1px solid var(--border-color);
	font-size: 0.85rem;
}

/* Texto encima de las horas */
.volunteer-date div:first-child {
	color: var(--text-muted);
	font-size: 0.75rem;
	margin-bottom: 5px;
}

#volunteer-observations {
	padding: 15px;
	font-size: 0.9rem;
	color: var(--text-muted);
}

/* Botones inferiores */
#button-container {
	margin-top: auto; /* Empuja los botones al fondo del panel */
	display: flex;
	gap: 10px;
	padding-top: 20px;
}

#button-container button {
	flex: 1;
	padding: 10px;
	border-radius: 6px;
	font-weight: 500;
	cursor: pointer;
	transition: all 0.2s;
}

#create-button { background-color: var(--primary-blue); color: white; border: none; }
#create-button:hover { background-color: #002244; }

#export-button { background-color: var(--bg-white); color: var(--primary-blue); border: 1px solid var(--primary-blue); }
#export-button:hover { background-color: var(--bg-main); }

#cancel-button { background-color: var(--bg-white); color: var(--status-red); border: 1px solid var(--status-red); }
#cancel-button:hover { background-color: #fef2f2; }
</file>

<file path="css/cadenas.css">
/* ============================
   Layout general de cadenas
   ============================ */
.cadena-list-wrapper {
    max-width: 1100px;
    margin: 0 auto;
}

.cadena-form-wrapper {
    max-width: 900px;
    margin: 0 auto;
}

.cadena-list-header,
.cadena-form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.cadena-list-header h2,
.cadena-form-header h2 {
    font-size: 1.4rem;
    margin: 0;
    color: var(--text-dark);
}

.cadena-list-header p,
.cadena-form-header p {
    margin: 6px 0 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* ============================
   Acciones superiores
   ============================ */
.cadena-header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
}

.cadena-create-btn {
    background-color: var(--primary-blue);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.cadena-create-btn:hover {
    background-color: var(--accent-blue);
    text-decoration: none;
}

.cadena-create-icon {
    font-size: 20px;
    line-height: 1;
}

/* ============================
   Tabla de cadenas
   ============================ */
.cadena-table-card {
    padding: 0;
    overflow: hidden;
}

.cadena-table {
    table-layout: fixed;
}

.cadena-table th:nth-child(1),
.cadena-table td:nth-child(1) { width: 15%; }
.cadena-table th:nth-child(2),
.cadena-table td:nth-child(2) { width: 50%; }
.cadena-table th:nth-child(3),
.cadena-table td:nth-child(3) { width: 20%; }
.cadena-table th:nth-child(4),
.cadena-table td:nth-child(4) { width: 15%; }

.cadena-row-actions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: auto;
}

/* ============================
   Botones de acciones de fila
   ============================ */
.cadena-edit-btn,
.cadena-delete-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 10px;
    background-color: #eaf2ff;
    color: #123c69;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    border: 1px solid #c7dbf5;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.cadena-edit-btn:hover,
.cadena-delete-check:hover {
    background-color: #d9eaff;
    color: #0b2d52;
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(18, 60, 105, 0.15);
}

.cadena-edit-btn:active,
.cadena-delete-check:active {
    transform: translateY(0);
    box-shadow: none;
}

.cadena-edit-icon {
    font-size: 14px;
    line-height: 1;
}

.cadena-delete-check {
    cursor: pointer;
}

.cadena-delete-check input {
    accent-color: var(--primary-blue);
    cursor: pointer;
}

.cadena-delete-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: #ef4444;
}

/* ============================
   Formulario de borrado/listado
   ============================ */
.cadena-delete-form {
    margin: 0;
}

.cadena-form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
}

.cadena-form-actions a,
.cadena-form-actions button {
    margin: 3px;
}

.cadena-delete-submit {
    background-color: white;
    color: var(--status-red);
    border: 1px solid var(--status-red);
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
}

.cadena-delete-submit:hover {
    background-color: #fef2f2;
}

/* ============================
   Formulario crear/editar cadena
   ============================ */
.cadena-form-card {
    padding: 25px;
}

.cadena-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.cadena-form-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.cadena-form-row {
    display: flex;
    gap: 18px;
}

.cadena-form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.cadena-form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dark);
}

.cadena-form-group input[type="text"] {
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.95rem;
    background-color: white;
    color: var(--text-dark);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.cadena-form-group input[type="text"]:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(68, 114, 196, 0.12);
}

.cadena-cancel-btn,
.cadena-form-actions .btn-outline {
    text-decoration: none;
    font-size: 1rem;
}

.cadena-cancel-btn:hover,
.cadena-form-actions .btn-outline:hover {
    text-decoration: none;
}

/* ============================
   Responsive básico
   ============================ */
@media (max-width: 800px) {
    .cadena-list-header,
    .cadena-form-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
    }

    .cadena-form-row {
        flex-direction: column;
    }

    .cadena-form-actions {
        flex-direction: column;
    }

    .cadena-form-actions button,
    .cadena-form-actions a {
        width: 100%;
    }

    .cadena-row-actions {
        flex-direction: column;
        align-items: flex-start;
    }
}

/* ============================
   Estado seleccionado para borrar
   ============================ */
.cadena-row-selected td {
    background-color: #fee2e2 !important;
    color: #991b1b;
}

.cadena-row-selected td:first-child {
    border-left: 4px solid #ef4444;
}

.cadena-row-selected .cadena-edit-btn {
    background-color: #fecaca !important;
    color: #991b1b !important;
    border-color: #ef4444 !important;
}
</file>

